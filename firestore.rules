rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isSessionMember(sessionId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.memberIds;
    }

    // Admins are added by hand in the Firebase console: a document in `admins` whose id is the
    // admin's uid. Nobody can make themselves an admin from the app.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Titles only an admin can give. Keep in step with grantOnly titles in src/game/titles.ts.
    function grantOnlyTitles() {
      return ['founding_member'];
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Profiles: anyone signed in can read them. Only you can edit yours, and you can't give
    // yourself an admin-only title. Admins can give and take back those titles, and nothing else.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && !('grantedTitles' in request.resource.data)
        && !request.resource.data.get('earnedTitles', []).hasAny(grantOnlyTitles());
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && !changes().hasAny(['grantedTitles'])
          && (!changes().hasAny(['earnedTitles'])
            || !request.resource.data.get('earnedTitles', []).hasAny(grantOnlyTitles())))
        || (isAdmin() && changes().hasOnly(['grantedTitles']))
      );
    }

    match /groups/{groupId} {
      // Admins can see every group, so they can moderate them.
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        // Members can edit the group.
        request.auth.uid in resource.data.memberIds
        // Anyone with the invite code can add themselves, and only themselves.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.removeAll(resource.data.memberIds).hasOnly([request.auth.uid])
          && resource.data.memberIds.removeAll(request.resource.data.memberIds).size() == 0
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        )
      );
      // Only admins can delete a group. Its games are kept.
      allow delete: if isAdmin();
    }

    // Invite codes point to a group. They can be looked up one at a time but not listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;
      allow delete: if isAdmin();
    }

    // Hub posts: anyone signed in can read and like them. One post per player per game.
    // Likes can only add or remove your own uid. Authors and admins can delete posts.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && postId == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.tiles.size() <= 18
        && request.resource.data.flowers.size() <= 8
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 280;
      allow update: if signedIn() && (
        (changes().hasOnly(['likedBy'])
          && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet())
            .union(resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()))
            .hasOnly([request.auth.uid]))
        // Comment counts go up or down by one, alongside adding or deleting a comment.
        || (changes().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1))
      );
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        // Your own comments, any comment on your post, or any comment if you're an admin.
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
          || isAdmin()
        );
      }
    }

    // What each finished game adds to its players' career stats, for the leaderboard. Anyone can
    // read them; only players in the game can write them, and only once it's finished.
    match /results/{sessionId} {
      allow read: if signedIn();
      allow create, update: if isSessionMember(sessionId)
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'finished'
        && request.resource.data.id == sessionId;
      allow delete: if isAdmin();
    }

    // Invitations to join a group. Group members can send them; only the sender and the invited
    // player can see one. It's deleted when it's answered, so there's nothing to update.
    match /groupInvites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && inviteId == request.resource.data.groupId + '_' + request.resource.data.toUid;
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      // Only admins can delete games, so nobody can wipe the history, not even whoever started it.
      allow delete: if isAdmin();

      match /hands/{handId} {
        allow read, create: if isSessionMember(sessionId);
        allow delete: if isAdmin();
      }
    }
  }
}
